{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tweaker Catalog",
  "type": "object",
  "required": [
    "schemaVersion",
    "catalogVersion",
    "compatibility",
    "categories",
    "services",
    "serviceGroups",
    "features"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogVersion": { "type": "string" },
    "serviceDisablePolicy": {
      "type": "string",
      "enum": ["launchctl", "cleanSweep"],
      "description": "Default disable method for services that omit disableMethod."
    },
    "compatibility": {
      "type": "object",
      "required": ["minimumMacOSMajor", "maximumMacOSMajor", "architectures"]
    },
    "categories": { "type": "array" },
    "services": { "type": "array" },
    "serviceGroups": { "type": "array" },
    "features": { "type": "array" }
  }
}
